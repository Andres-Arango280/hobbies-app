{
  "name": "hobbies-app-cypress-tests",
  "version": "1.0.0",
  "description": "Suite de pruebas Cypress para Hobbies App",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:api": "cypress run --spec 'cypress/e2e/api_tests.cy.js'",
    "cy:run:security": "cypress run --spec 'cypress/e2e/security_tests.cy.js'",
    "cy:run:regression": "cypress run --spec 'cypress/e2e/regression_tests.cy.js'",
    "cy:run:accessibility": "cypress run --spec 'cypress/e2e/accessibility_tests.cy.js'",
    "cy:run:ui": "cypress run --spec 'cypress/e2e/ui_tests.cy.js'",
    "cy:run:all": "cypress run --spec 'cypress/e2e/**/*.cy.js'"
  },
  "devDependencies": {
    "cypress": "^13.0.0",
    "axe-core": "^4.9.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0"
  }
}