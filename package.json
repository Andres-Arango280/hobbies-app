{
  "name": "hobbies-app",
  "version": "1.0.0",
  "description": "Hobbies App con pruebas Jest y Cypress",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "cross-env NODE_ENV=test jest --coverage",
    "cy:open": "cypress open",
    "cy:open:chrome": "cypress open --browser chrome",
    "cy:run": "cypress run",
    "cy:run:api": "cypress run --spec cypress/e2e/api_tests.cy.js",
    "cy:run:security": "cypress run --spec cypress/e2e/security_tests.cy.js",
    "cy:run:regression": "cypress run --spec cypress/e2e/regression_tests.cy.js",
    "cy:run:accessibility": "cypress run --spec cypress/e2e/accessibility_tests.cy.js",
    "cy:run:ui": "cypress run --spec cypress/e2e/ui_tests.cy.js",
    "cy:run:all": "cypress run --spec cypress/e2e/**/*.cy.js",
    "cy:record": "cypress run --record --key 85c18f3f-23b5-4cce-a31a-e08c6f015740"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "axe-core": "^4.11.4",
    "cross-env": "^10.1.0",
    "cypress": "^13.17.0",
    "jest": "^29.7.0",
    "jest-extended": "^7.0.0",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^4.3.0",
    "mongodb-memory-server": "^9.5.0",
    "mongoose": "^9.6.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.4"
  }
}
